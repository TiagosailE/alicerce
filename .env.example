# Environment variables read by the application. Nothing here is required for
# local development: bin/setup starts Postgres with Docker Compose on port 5433
# and the defaults in config/database.yml match it. Real values are set on the
# host (Render dashboard) and never committed.

# Local only, to use a Postgres you already run instead of the Compose service.
# Export them in your shell before bin/setup.
# PGHOST=/var/run/postgresql
# PGPORT=5432
# PGUSER=your_user
# PGPASSWORD=

# Production
APP_HOST=alicerce.example.com
DATABASE_URL=postgres://alicerce_app.ref:password@host:5432/postgres?sslmode=verify-full&sslrootcert=/rails/config/certs/supabase-ca.crt
MIGRATION_DATABASE_URL=postgres://alicerce_owner.ref:password@host:5432/postgres?sslmode=verify-full&sslrootcert=/rails/config/certs/supabase-ca.crt
SECRET_KEY_BASE=generate-with-bin-rails-secret
SEED_USER_PASSWORD=set-a-strong-password-for-the-demo-users
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=3
SOLID_QUEUE_IN_PUMA=1
JOB_THREADS=1
RAILS_LOG_LEVEL=info
